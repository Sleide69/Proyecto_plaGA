{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Detección de Plagas",
        "description": "Documentación de la API para el sistema de detección de plagas usando Laravel y YOLOv5",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor local"
        }
    ],
    "paths": {
        "/api/notificaciones": {
            "get": {
                "tags": [
                    "Notificaciones"
                ],
                "summary": "Obtener las últimas 10 notificaciones del usuario autenticado",
                "operationId": "4a5488228077528a278bea003da9a3cc",
                "responses": {
                    "200": {
                        "description": "Lista de notificaciones",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "notificaciones": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 1
                                                    },
                                                    "user_id": {
                                                        "type": "integer",
                                                        "example": 5
                                                    },
                                                    "mensaje": {
                                                        "type": "string",
                                                        "example": "Tienes una nueva alerta"
                                                    },
                                                    "created_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2025-07-19T20:00:00Z"
                                                    },
                                                    "updated_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2025-07-19T20:00:00Z"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Notificaciones"
                ],
                "summary": "Crear una nueva notificación y emitirla en tiempo real",
                "operationId": "d2dd16a0c0f439306ecfa7ec0312972f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mensaje"
                                ],
                                "properties": {
                                    "mensaje": {
                                        "type": "string",
                                        "maxLength": 255,
                                        "example": "Tienes una nueva alerta"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Notificación creada exitosamente y emitida por WebSocket",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "notificacion": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "user_id": {
                                                    "type": "integer",
                                                    "example": 5
                                                },
                                                "mensaje": {
                                                    "type": "string",
                                                    "example": "Tienes una nueva alerta"
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2025-07-19T20:00:00Z"
                                                },
                                                "updated_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2025-07-19T20:00:00Z"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/register": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registrar un nuevo usuario",
                "operationId": "8a56853624e025573120a09a4c75d468",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "cedula",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Juan Pérez"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "cedula": {
                                        "type": "string",
                                        "example": "1234567890"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Redirección al login con mensaje de éxito"
                    },
                    "422": {
                        "description": "Error de validación"
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Iniciar sesión y obtener token Sanctum",
                "operationId": "a3b306d14572d1f4bd6c064b3233e7b8",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "302": {
                        "description": "Redirección a /captura si las credenciales son válidas"
                    },
                    "401": {
                        "description": "Credenciales inválidas"
                    }
                }
            }
        },
        "/api/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cerrar sesión y eliminar tokens Sanctum",
                "operationId": "fe8f3429cd6979b3b4517e186505f9f9",
                "responses": {
                    "302": {
                        "description": "Redirección a la página de inicio"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/captura": {
            "post": {
                "tags": [
                    "Captura"
                ],
                "summary": "Guardar imagen base64 y detectar plagas",
                "description": "Recibe una imagen en formato base64, la guarda en el servidor, la envía a un microservicio para detección de plagas y retorna la vista con la imagen procesada y los resultados.",
                "operationId": "9e7e4282137529451f8b04d7442aed17",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "imagen"
                                ],
                                "properties": {
                                    "imagen": {
                                        "type": "string",
                                        "format": "base64",
                                        "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD..."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Vista con imagen procesada y resultados de detección"
                    },
                    "400": {
                        "description": "No se recibió ninguna imagen"
                    },
                    "500": {
                        "description": "Error al comunicarse con el detector de plagas"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/captura/formulario": {
            "get": {
                "tags": [
                    "Captura"
                ],
                "summary": "Mostrar formulario para subir una imagen",
                "operationId": "fddd2ce756277d208080d4fff29e07c2",
                "responses": {
                    "200": {
                        "description": "Formulario HTML para subir imagen"
                    }
                }
            }
        },
        "/api/detecciones": {
            "post": {
                "tags": [
                    "Detecciones"
                ],
                "summary": "Registrar una detección de plaga",
                "description": "Registra una nueva detección de plaga asociada al usuario autenticado. Este endpoint requiere autenticación (Sanctum).",
                "operationId": "c941fcd02ee2d40c7e337af308c03987",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "plaga",
                                    "ubicacion",
                                    "hora"
                                ],
                                "properties": {
                                    "plaga": {
                                        "type": "string",
                                        "example": "Mosca blanca"
                                    },
                                    "ubicacion": {
                                        "type": "string",
                                        "example": "Invernadero 3, sector norte"
                                    },
                                    "hora": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2025-07-19T14:30:00Z"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Detección registrada exitosamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "mensaje": {
                                            "type": "string",
                                            "example": "Detectada y guardada"
                                        },
                                        "id": {
                                            "type": "integer",
                                            "example": 42
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/ws/usuario.{user_id}": {
            "get": {
                "tags": [
                    "WebSocket"
                ],
                "summary": "Canal WebSocket para notificaciones en tiempo real usando Laravel Reverb",
                "description": "\r\nConéctate al canal <b>ws://localhost:8080/usuario.{user_id}</b> para recibir notificaciones en tiempo real.<br>\r\n<ul>\r\n    <li>El parámetro <code>user_id</code> corresponde al ID del usuario autenticado.</li>\r\n    <li>Usa <b>Laravel Echo</b> en el frontend para escuchar el evento <code>.NuevaNotificacion</code> en este canal.</li>\r\n    <li>Ejemplo de conexión (con Javascript y Laravel Echo):<br>\r\n    <pre>\r\nwindow.Echo.channel('usuario.' + userId)\r\n    .listen('.NuevaNotificacion', (e) => {\r\n        console.log('Notificación:', e.notificacion);\r\n    });\r\n    </pre>\r\n    </li>\r\n</ul>\r\n<b>Nota:</b> Swagger UI y Postman <u>no permiten probar WebSockets directamente</u>. Usa una herramienta como <a href='https://www.websocketking.com/' target='_blank'>WebSocket King Client</a>, Insomnia, o tu frontend para conectarte y escuchar eventos en tiempo real.\r\n",
                "operationId": "4af58d15ecb66b7f3820930cc4874deb",
                "parameters": [
                    {
                        "name": "user_id",
                        "in": "path",
                        "description": "ID del usuario autenticado",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "101": {
                        "description": "Switching Protocols - Conexión WebSocket establecida"
                    },
                    "400": {
                        "description": "Solicitud incorrecta (por ejemplo, falta user_id)"
                    },
                    "403": {
                        "description": "No autorizado para acceder a este canal"
                    }
                },
                "servers": [
                    {
                        "url": "ws://localhost:8080",
                        "description": "Servidor WebSocket Reverb local"
                    }
                ]
            }
        },
        "/ws/detecciones": {
            "get": {
                "tags": [
                    "WebSocket"
                ],
                "summary": "Canal WebSocket global para detecciones en tiempo real usando Laravel Reverb",
                "description": "Conéctate al canal <b>ws://localhost:8080/detecciones</b> para recibir en tiempo real las nuevas detecciones reportadas por cualquier usuario.<br>\r\n<ul>\r\n    <li>Este canal es público para todos los usuarios autenticados.</li>\r\n    <li>Usa <b>Laravel Echo</b> en el frontend para escuchar el evento <code>.NuevaDeteccion</code> en este canal.</li>\r\n    <li>Ejemplo de conexión (con Javascript y Laravel Echo):<br>\r\n    <pre>\r\nwindow.Echo.channel('detecciones')\r\n    .listen('.NuevaDeteccion', (e) => {\r\n        console.log('Nueva detección:', e.deteccion);\r\n    });\r\n    </pre>\r\n    </li>\r\n</ul>\r\n<b>Nota:</b> Swagger UI y Postman <u>no permiten probar WebSockets directamente</u>. Usa una herramienta como <a href='https://www.websocketking.com/' target='_blank'>WebSocket King Client</a>, Insomnia, o tu frontend para conectarte y escuchar eventos en tiempo real.",
                "operationId": "af573c87c0c9bec0783d2a67c0b0f29c",
                "responses": {
                    "101": {
                        "description": "Switching Protocols - Conexión WebSocket establecida"
                    },
                    "403": {
                        "description": "No autorizado para acceder a este canal"
                    }
                },
                "servers": [
                    {
                        "url": "ws://localhost:8080",
                        "description": "Servidor WebSocket Reverb local"
                    }
                ]
            }
        },
        "/api/plagas/detectar": {
            "post": {
                "tags": [
                    "Plagas"
                ],
                "summary": "Detectar plagas en una imagen base64 usando YOLOv5",
                "operationId": "7db10e707ecf8fc0e91891743f955bda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "imagen"
                                ],
                                "properties": {
                                    "imagen": {
                                        "type": "string",
                                        "format": "base64",
                                        "example": "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQAAAQABAAD..."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Vista con imagen procesada y resultados de detección"
                    },
                    "400": {
                        "description": "Formato de imagen inválido o error en la detección"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Notificaciones",
            "description": "Notificaciones"
        },
        {
            "name": "Autenticación",
            "description": "Autenticación"
        },
        {
            "name": "Captura",
            "description": "Captura"
